# ==============================================================================
# LEDGERGUARD — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=7860
DEMO_MODE=true
LOG_LEVEL=info

# Base MongoDB Atlas URI — tenant databases dynamically appended as lg_tenant_<orgId>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
CONTROL_DB_NAME=ledgerguard_control

# Mongoose connection pool budgeting
# maxPoolSize per tenant is 5, minPoolSize is 0
MAX_TENANT_CONNECTIONS=10
IDLE_CONNECTION_TIMEOUT_MS=300000

# Managed Redis (TLS) URL
REDIS_URL=rediss://default:<password>@<host>:<port>

# API Gateway RS256 JWT Keys (Base64-encoded PEM strings)
JWT_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQp...
JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0K...
JWT_ISSUER=ledgerguard-gateway
JWT_AUDIENCE=ledgerguard-api
JWT_EXPIRES_IN=900

# Security & CORS (exact origin list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
