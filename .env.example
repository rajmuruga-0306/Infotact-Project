# ==============================================================================
# LEDGERGUARD — MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# IMPORTANT:
# - Copy this file to backend/.env and frontend/.env respectively.
# - DO NOT commit real secrets or production credentials to Git.
# - Financial amounts are always in integer minor units (paise/cents).
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND RUNTIME & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Node runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Server port (default 7860 to match standard container/hosting port)
PORT=7860

# Enables demo mode routes (/api/v1/demo/*) and simulated rollback header
# Must be set to 'false' in production environments
DEMO_MODE=true

# Pino logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Base MongoDB Atlas URI used for the control database and tenant connections.
# Tenant databases are dynamically created as 'lg_tenant_<orgId>'.
# Note: Connection budget per instance is maxPoolSize (5) * (1 control + maxTenants (10)) = 55 capacity.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Control database name (stores organizations, platform users, platform audit logs)
CONTROL_DB_NAME=ledgerguard_control

# Maximum number of concurrently open tenant Mongoose connections in LRU pool
MAX_TENANT_CONNECTIONS=10

# Idle timeout (ms) before closing inactive tenant database connections (5 min default)
IDLE_CONNECTION_TIMEOUT_MS=300000

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (MANAGED REDIS / UPSTASH / REDIS CLOUD)
# ------------------------------------------------------------------------------
# Redis connection URL with TLS support (rediss://)
# Used for: idempotency locks (Lua release), nonce replay cache, token denylist, rate limits
REDIS_URL=rediss://default:<password>@<host>:<port>

# ------------------------------------------------------------------------------
# API GATEWAY CRYPTOGRAPHIC AUTHENTICATION (RS256 JWT)
# ------------------------------------------------------------------------------
# Base64-encoded RSA Private Key (PEM format, PKCS#8 or PKCS#1) for signing gateway JWTs
JWT_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQp...

# Base64-encoded RSA Public Key (PEM format, SPKI or PKCS#1) for verifying gateway JWTs
JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0K...

# JWT Token configuration
JWT_ISSUER=ledgerguard-gateway
JWT_AUDIENCE=ledgerguard-api
JWT_EXPIRES_IN=900

# ------------------------------------------------------------------------------
# SECURITY, CORS & RATE LIMITING
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed origins (no trailing slashes, NO wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# General rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Strict auth rate limiting (login & registration requests per window)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# FRONTEND VITE CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL used by the React client
VITE_API_URL=http://localhost:7860/api/v1

# Socket.IO gateway server URL
VITE_SOCKET_URL=http://localhost:7860
