# ==============================================================================
# LEDGERGUARD — FRONTEND CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# Note: Vite exposes only variables starting with VITE_ to client code.
# ==============================================================================

# Backend REST API base URL
VITE_API_URL=http://localhost:7860/api/v1

# Backend Socket.IO server URL
VITE_SOCKET_URL=http://localhost:7860
